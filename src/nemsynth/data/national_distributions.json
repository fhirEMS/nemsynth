  "dispatch_reason_approx": {
    "_element": "eDispatch.01",
    "_measured": false,
    "_reasoning": [
      "The report's published figure is that 'sick person' is the most common",
      "dispatch complaint at ~20% (2020 PRRD description, PMID 35583482).",
      "The remaining shape below is a WORKING ASSUMPTION consistent with that",
      "anchor and with the injury findings (falls = 37% of injury causes), not",
      "a measured distribution. Replace wholesale when the PRRD is licensed."
    ],
    "Sick Person": 0.20,
