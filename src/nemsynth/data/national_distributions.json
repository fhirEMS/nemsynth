  "age_years_approx": {
    "_element": "ePatient.15",
    "_measured": false,
    "_reasoning": [
      "The report's 'typical patient' age band skews old (71-80 is the largest",
      "single band at 16.1%). The bands below reproduce that skew — EMS is",
      "disproportionately geriatric — without claiming to be the published",
      "distribution, which the report does not give in full."
    ],
    "bands": [
      {"min": 0, "max": 1, "weight": 0.01},
      {"min": 1, "max": 17, "weight": 0.07},
