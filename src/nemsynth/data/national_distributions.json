{
  "_source": {
    "title": "2022 National EMS Data Report",
    "publisher": "NEMSIS Technical Assistance Center (NHTSA Office of EMS)",
    "url": "https://nemsis.org/wp-content/uploads/2025/02/NEMSIS-End-of-Year-Report-2023.pdf",
    "basis": "42,302,358 911-response (scene) EMS activations",
    "retrieved": "2026-08-10",
    "note": [
      "Every percentage below is transcribed from that report, not estimated.",
      "Where this file carries a number the report does NOT publish, the key is",
      "suffixed `_approx` and the reasoning is stated inline — so a reader can",
      "always tell measured national data from our working assumption.",
      "Refine against the Public-Release Research Dataset (60.3M activations)",
      "when a licensed extract is available."
    ]
  },

